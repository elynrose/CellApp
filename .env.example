# Copy to .env and fill from Firebase Console → Project settings → Your apps → Web app
# Required for `vite build` / production if you use a different project than the code fallbacks.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (Analytics)
# VITE_FIREBASE_MEASUREMENT_ID=
